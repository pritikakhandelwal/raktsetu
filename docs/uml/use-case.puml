@startuml use-case
' RaktSetu use cases (v2): the web app's three roles, the console and simulator, and external systems.
' Actors on the left use the arrows' tails; hospital staff and the SMS provider sit on the right.
left to right direction
skinparam packageStyle rectangle

actor "Network administrator" as Admin
actor "Blood centre staff" as Staff
actor "Simulator" as Sim <<system>>
actor "Hospital staff" as Hosp
actor "SMS / WhatsApp provider" as Sms <<system>>

rectangle RaktSetu {
  package "Administration" {
    usecase "Set up the network (first run)" as Setup
    usecase "Manage facilities and routes" as Facilities
    usecase "Manage people and passwords" as People
    usecase "Generate and compare transfer plans" as Plan
    usecase "Approve or reject transfers" as Approve
    usecase "View and verify the audit log" as Audit
    usecase "Run the simulation" as Simulate
  }
  package "Blood centre" {
    usecase "Log collected units" as Log
    usecase "Report daily stock" as Report
    usecase "Dispatch a request" as Dispatch
    usecase "Receive a transfer" as ReceiveT
    usecase "Discard a damaged unit" as Discard
  }
  package "Hospital" {
    usecase "Raise an emergency or routine request" as Raise
    usecase "Cancel a request before dispatch" as Cancel
    usecase "Confirm receipt" as Confirm
    usecase "Check compatibility and availability" as Check
  }
  package "Shared" {
    usecase "Sign in and change password" as SignIn
    usecase "Receive urgent alerts" as Alerts
    usecase "Record in the audit log" as Record
  }
}

Admin --> Setup
Admin --> Facilities
Admin --> People
Admin --> Plan
Admin --> Approve
Admin --> Audit
Admin --> Simulate
Admin --> SignIn
Sim --> Simulate
Staff --> Log
Staff --> Report
Staff --> Dispatch
Staff --> ReceiveT
Staff --> Discard
Staff --> SignIn
Staff --> Alerts
Raise <-- Hosp
Cancel <-- Hosp
Confirm <-- Hosp
Check <-- Hosp
SignIn <-- Hosp
Alerts <-- Hosp
Alerts --> Sms

Raise ..> Check : <<include>>
Raise ..> Record : <<include>>
Approve ..> Record : <<include>>
Log ..> Record : <<include>>
Discard ..> Record : <<include>>
Alerts ..> Raise : <<extend>>
@enduml

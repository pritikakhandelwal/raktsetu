@startuml domain-classes
' RaktSetu domain class diagram (v2, end of Phase 1). Keep in sync with raktsetu-domain.
skinparam classAttributeIconSize 0
hide empty members

package interfaces {
  interface Identifiable {
    +getId() : String
  }
  interface ExpiryTracked {
    +getExpiryDate() : LocalDate
    +daysToExpiry(today : LocalDate) : long
    +isExpired(today : LocalDate) : boolean
  }
  interface Transfusable {
    +compatibilityWith(recipient : BloodGroup) : CompatibilityResult
    +canTransfuseTo(recipient : BloodGroup) : boolean
  }
  interface DistanceProvider {
    +route(from : String, to : String) : Optional<Route>
  }
  interface Exportable {
    +toCsvRow() : List<String>
  }
  interface AuditTrail {
    +record(event : AuditEvent)
  }
  interface StockDataSource {
    +load() : LoadResult
    +save(data : NetworkData)
  }
}

package model {
  enum BloodGroup {
    O_NEG, O_POS, A_NEG, A_POS, B_NEG, B_POS, AB_NEG, AB_POS
    +canGiveRedCellsTo(r : BloodGroup) : boolean
    +canGivePlasmaTo(r : BloodGroup) : boolean
    +label() : String
    +{static} parse(text : String) : BloodGroup
  }
  enum ComponentType {
    WHOLE_BLOOD, RED_CELLS, PLATELETS, PLASMA
    +newUnit(id, group, collectedOn) : BloodComponent
  }
  enum Compatibility {
    IDENTICAL, COMPATIBLE, ALLOWED_WITH_WARNING, INCOMPATIBLE
  }
  class CompatibilityResult <<record>> {
    +level : Compatibility
    +reason : String
  }

  abstract class BloodComponent {
    -unitId : String
    -bloodGroup : BloodGroup
    -collectedOn : LocalDate
    -expiryOverride : LocalDate
    #BloodComponent(id, group, collectedOn)
    #BloodComponent(id, group, collectedOn, expiryOverride)
    +{abstract} getType() : ComponentType
    +{abstract} getShelfLifeDays() : int
    +{abstract} getStorageCondition() : String
    +getExpiryDate() : LocalDate
  }
  class WholeBlood
  class RedCellConcentrate
  class Platelets
  class FreshFrozenPlasma

  abstract class Facility {
    -id : String
    -name : String
    -lastReportedOn : LocalDate
    +{abstract} canCollect() : boolean
    +{abstract} canStore() : boolean
    +getInventory() : Inventory
    +daysSinceReport(today) : long
  }
  class HubBloodCentre
  class StorageCentre
  class Hospital

  class TransferOrder {
    -id : String
    -units : List<BloodComponent>
    -plannedOn : LocalDate
    -route : Route
    -status : TransferStatus
    +markCompleted()
    +reject()
  }
  enum TransferStatus {
    PROPOSED, COMPLETED, REJECTED
  }
  class BloodRequest <<record>> {
    +hospitalId : String
    +component : ComponentType
    +recipient : BloodGroup
    +quantity : int
    +urgency : Urgency
  }
  enum Urgency {
    ROUTINE, EMERGENCY
  }
  class UsageHistory {
    +record(date, facilityId, component, group, units)
    +averageDaily(facilityId, component, group, today) : double
  }
  class Route <<record>> {
    +distanceKm : int
    +travelMinutes : int
  }
  class TableDistanceProvider
  class AuditEvent <<record>>
  class WastageRecord <<record>>
  class NetworkData <<record>>

  class Inventory {
    -stock : EnumMap<ComponentType, EnumMap<BloodGroup, PriorityQueue<BloodComponent>>>
    +add(unit : BloodComponent)
    +issue(type, group, qty, today) : List<BloodComponent>
    +removeExpired(today) : List<BloodComponent>
    +take(unitId) : Optional<BloodComponent>
    +countUsable(type, group, today) : int
  }
}

package exception {
  class RaktSetuException
  class InsufficientStockException
  class IncompatibleBloodException
  class UnitExpiredException
  class FacilityNotFoundException
  class InvalidDataException
}

Identifiable <|.. BloodComponent
ExpiryTracked <|.. BloodComponent
Transfusable <|.. BloodComponent
Identifiable <|.. Facility

BloodComponent <|-- WholeBlood
BloodComponent <|-- RedCellConcentrate
BloodComponent <|-- Platelets
BloodComponent <|-- FreshFrozenPlasma

Facility <|-- HubBloodCentre
Facility <|-- StorageCentre
Facility <|-- Hospital

Facility *-- "1" Inventory : owns >
Inventory o-- "0..*" BloodComponent : holds (FEFO) >
BloodComponent --> "1" BloodGroup
Transfusable ..> CompatibilityResult
CompatibilityResult --> Compatibility
ComponentType ..> BloodComponent : creates

DistanceProvider <|.. TableDistanceProvider
Identifiable <|.. TransferOrder
Exportable <|.. TransferOrder
Exportable <|.. WastageRecord
TransferOrder --> "1" Facility : source >
TransferOrder --> "1" Facility : destination >
TransferOrder --> "1..*" BloodComponent
TransferOrder --> TransferStatus
TransferOrder --> Route
BloodRequest --> Urgency
AuditTrail ..> AuditEvent
NetworkData o-- "0..*" Facility
NetworkData o-- UsageHistory

Exception <|-- RaktSetuException
RaktSetuException <|-- InsufficientStockException
RaktSetuException <|-- IncompatibleBloodException
RaktSetuException <|-- UnitExpiredException
RaktSetuException <|-- FacilityNotFoundException
RaktSetuException <|-- InvalidDataException
@enduml
